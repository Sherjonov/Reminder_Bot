# ===== Telegram =====
# Bot tokenini @BotFather dan oling
BOT_TOKEN=123456789:PUT_YOUR_BOT_TOKEN_HERE
# Admin Telegram ID lari (vergul bilan). O'z ID ingizni @userinfobot dan bilib olasiz
ADMINS=123456789

# ===== MySQL (HeidiSQL dagi server) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reminder_bot

# ===== Qo'shimcha (ixtiyoriy — o'zgartirmasangiz ham bo'ladi) =====
DEFAULT_TZ=Asia/Tashkent        # yangi foydalanuvchilar uchun standart vaqt mintaqasi
SCHEDULER_TICK=10               # eslatmalar necha soniyada bir tekshiriladi
THROTTLE_RATE=0.5               # spamdan himoya: so'rovlar orasidagi minimal masofa (soniya)
DIGEST_HOUR=8                   # "Kunlik xulosa" yuboriladigan mahalliy soat
SET_BOT_PROFILE=true            # ishga tushganda botning tavsif matnlarini yangilash
BACKUP_ENABLED=true             # bazani SQL fayl qilib zaxiralash va adminlarga yuborish
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7                   # data/backups/ da nechta zaxira saqlansin
HEALTH_SERVER=true              # Render/Railway uchun: GET /health
HEALTH_PORT=8080                # hosting PORT bersa, o'sha ishlatiladi
LOG_LEVEL=INFO
